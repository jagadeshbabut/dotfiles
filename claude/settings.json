{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "theme": "custom:dracula",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "effortLevel": "high",
  "showTurnDuration": true,
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "enabledPlugins": {
    "warp@claude-code-warp": true,
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "deploy-on-aws@claude-plugins-official": true,
    "terraform@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code needs your attention\" with title \"Claude Code\"'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "mcpServers": {
    "browser-tools-mcp": {
      "command": "npx",
      "args": ["-y", "@agentdeskai/browser-tools-mcp@1.2.1"]
    }
  },
  "permissions": {
    "allow": [
      "Bash(cd *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(which *)",
      "Bash(chmod *)",
      "Bash(sudo chmod *)",
      "Bash(sudo cp *)",
      "Bash(wc *)",
      "Bash(wc:*)",
      "Bash(sort *)",
      "Bash(head *)",
      "Bash(head:*)",
      "Bash(tail *)",
      "Bash(tail:*)",
      "Bash(echo *)",
      "Bash(echo:*)",
      "Bash(sed *)",
      "Bash(sed:*)",
      "Bash(grep *)",
      "Bash(sleep *)",
      "Bash(bash:*)",

      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git commit:*)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git fetch *)",
      "Bash(git remote *)",
      "Bash(git checkout *)",
      "Bash(git ls-remote *)",
      "Bash(git init)",
      "Bash(git init *)",

      "Bash(gh auth *)",
      "Bash(gh auth:*)",
      "Bash(gh repo *)",
      "Bash(gh pr *)",
      "Bash(/opt/homebrew/bin/gh auth:*)",
      "Bash(/opt/homebrew/bin/gh api:*)",

      "Bash(node *)",
      "Bash(bun *)",
      "Bash(bunx playwright:*)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm install *)",
      "Bash(npm info:*)",
      "Bash(npx playwright:*)",

      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(python3:*)",
      "Bash(uv *)",
      "Bash(uv run *)",
      "Bash(AWS_ENDPOINT_URL=* uv run *)",

      "Bash(docker build *)",
      "Bash(docker run *)",
      "Bash(docker compose *)",
      "Bash(docker exec *)",
      "Bash(docker logs *)",
      "Bash(docker ps)",
      "Bash(docker ps *)",
      "Bash(docker-compose *)",

      "Bash(go *)",

      "Bash(make)",
      "Bash(make *)",

      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl top *)",
      "Bash(kubectl config get-contexts --no-headers)",
      "Bash(kubectl --context=* apply *)",
      "Bash(kubectl --context=* delete *)",
      "Bash(kubectl --context=* edit *)",
      "Bash(kubectl --context=* exec *)",

      "Bash(helm list *)",
      "Bash(helm status *)",

      "Bash(terraform plan *)",
      "Bash(terraform validate *)",
      "Bash(terraform fmt *)",
      "Bash(terraform state list *)",
      "Bash(terraform state show *)",

      "Bash(brew list)",
      "Bash(brew list *)",
      "Bash(brew info *)",
      "Bash(brew search *)",
      "Bash(brew install:*)",
      "Bash(brew --version)",
      "Bash(pyenv *)",

      "Bash(curl *)",
      "Bash(curl:*)",

      "Bash(launchctl load *)",
      "Bash(launchctl list *)",
      "Bash(launchctl unload *)",
      "Bash(launchctl bootstrap *)",
      "Bash(launchctl bootout *)",

      "Bash(fish:*)",
      "Bash(starship:*)",
      "Bash(plutil:*)",
      "Bash(fc-list:*)",

      "Bash(granted completion:*)",
      "Bash(granted:*)",
      "Bash(aws configure list-profiles)",

      "Bash(mise list *)",
      "Bash(mise use *)",
      "Bash(yamllint *)",
      "Bash(shellcheck *)",
      "Bash(jq *)",
      "Bash(yq *)",

      "Bash(claude mcp:*)",
      "Bash(rtk gain:*)",

      "Skill(update-config)",

      "WebSearch",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.github.com)",

      "mcp__atlassian__getAccessibleAtlassianResources",
      "mcp__atlassian__getConfluencePage",
      "mcp__atlassian__getConfluenceSpaces",
      "mcp__atlassian__fetchAtlassian",
      "mcp__atlassian__searchConfluenceUsingCql",
      "mcp__atlassian__createConfluencePage",
      "mcp__atlassian__updateConfluencePage",

      "mcp__claude_ai_Atlassian__getAccessibleAtlassianResources",
      "mcp__claude_ai_Atlassian__getJiraIssue",
      "mcp__claude_ai_Atlassian__getJiraIssueTypeMetaWithFields",
      "mcp__claude_ai_Atlassian__getVisibleJiraProjects",
      "mcp__claude_ai_Atlassian__searchJiraIssuesUsingJql",
      "mcp__claude_ai_Atlassian__getConfluencePage",
      "mcp__claude_ai_Atlassian__getConfluenceSpaces",
      "mcp__claude_ai_Atlassian__searchConfluenceUsingCql",
      "mcp__claude_ai_Atlassian__createConfluencePage",
      "mcp__claude_ai_Atlassian__fetch",

      "mcp__claude_ai_Slack__slack_read_thread"
    ],
    "deny": [
      "Bash(sudo rm -rf /)",
      "Bash(chmod 777 *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(~/.ssh/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl exec *)",
      "Bash(kubectl edit *)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(helm uninstall *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(terraform import *)",
      "Bash(docker rm *)",
      "Bash(brew install *)",
      "Bash(brew uninstall *)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)"
    ]
  }
}
