[user]
	email = jagadesh.thangavelu@slicebank.com
	name = slice-jagadesht

[includeIf "gitdir:~/personal/"]
	path = ~/.gitconfig-personal

[credential]
	helper = osxkeychain

[core]
	pager = delta
	autocrlf = input
	excludesfile = ~/.gitignore_global

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[rebase]
	autoStash = true

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = Dracula
	plus-style = "syntax #003800"
	minus-style = "syntax #3f0001"

[delta "interactive"]
	keep-plus-minus-markers = false

[alias]
	last        = log -1 HEAD
	unstage     = reset HEAD --
	amend       = commit --amend --no-edit
	branches    = branch -a --sort=-committerdate
	tags        = tag -l --sort=-v:refname
	stashes     = stash list
	wip         = !git add -A && git commit -m 'wip'
	undo        = reset --soft HEAD~1
	contributors = shortlog --summary --numbered
	graph       = log --graph --oneline --all --decorate
