# AWS SSO config — fill in your org's values
# Copy SSO portal URL and account IDs from your AWS access portal

[sso-session work-sso]
sso_start_url           = https://YOUR_SSO_ID.awsapps.com/start/
sso_region              = ap-south-1
sso_registration_scopes = sso:account:access

[default]
sso_session    = work-sso
sso_start_url  = https://YOUR_SSO_ID.awsapps.com/start/
sso_region     = ap-south-1

[profile audit-account]
granted_sso_start_url      = https://YOUR_SSO_ID.awsapps.com/start/#
granted_sso_region         = ap-south-1
granted_sso_account_id     = 000000000000
granted_sso_role_name      = YOUR_ROLE_NAME
common_fate_generated_from = aws-sso
credential_process         = granted credential-process --profile audit-account

